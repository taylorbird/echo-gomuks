{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "windows": [
      {
        "create": false,
        "title": "echo",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "decorations": true,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Matrix client",
    "linux": {
      "deb": {
        "depends": ["gstreamer1.0-plugins-good", "gstreamer1.0-libav"]
      }
    }
  }
}
