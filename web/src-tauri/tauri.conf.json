{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "echo",
  "version": "0.7.3",
  "identifier": "dev.tbird.echo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:6173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "create": false,
        "title": "echo",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState",
          "radius": 10
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/Assets.car",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/gomuks"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "Developer ID Application: Taylor Bird (UFCDGSKCXB)"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5OTRFNkExN0RCRkQ0RUIKUldUcjFMOTlvZWFVYVdFN0txVjUybDhGR1FwNFpLa0swSjREVUV3UnFkL0VHbWZZK1h2N1Q5RnAK",
      "endpoints": [
        "https://github.com/taylorbird/echo/releases/latest/download/latest.json"
      ]
    }
  }
}
